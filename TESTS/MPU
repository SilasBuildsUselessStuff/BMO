#define LGFX_USE_V1

#include <Arduino.h>
#include <LovyanGFX.hpp>

#include <SPI.h>
#include <SD.h>
#include <FS.h>

// ============================================================
// DISPLAY CONFIGURATION
// Board: ESP32-3248S035C
// Display: ST7796
// Landscape resolution: 480 x 320
// ============================================================

class LGFX : public lgfx::LGFX_Device
{
  lgfx::Panel_ST7796 _panel_instance;
  lgfx::Bus_SPI _bus_instance;
  lgfx::Light_PWM _light_instance;

public:
  LGFX(void)
  {
    // --------------------------------------------------------
    // Display SPI bus
    // --------------------------------------------------------

    {
      auto cfg = _bus_instance.config();

      cfg.spi_host = HSPI_HOST;
      cfg.spi_mode = 0;

      cfg.freq_write = 80000000;
      cfg.freq_read = 40000000;

      cfg.spi_3wire = true;
      cfg.use_lock = true;
      cfg.dma_channel = SPI_DMA_CH_AUTO;

      cfg.pin_sclk = 14;
      cfg.pin_mosi = 13;
      cfg.pin_miso = 12;
      cfg.pin_dc = 2;

      _bus_instance.config(cfg);
      _panel_instance.setBus(&_bus_instance);
    }

    // --------------------------------------------------------
    // ST7796 panel
    // --------------------------------------------------------

    {
      auto cfg = _panel_instance.config();

      cfg.pin_cs = 15;
      cfg.pin_rst = -1;
      cfg.pin_busy = -1;

      cfg.panel_width = 320;
      cfg.panel_height = 480;

      cfg.offset_x = 0;
      cfg.offset_y = 0;
      cfg.offset_rotation = 0;

      cfg.dummy_read_pixel = 8;
      cfg.dummy_read_bits = 1;

      cfg.readable = true;
      cfg.invert = false;
      cfg.rgb_order = false;
      cfg.dlen_16bit = false;
      cfg.bus_shared = true;

      _panel_instance.config(cfg);
    }

    // --------------------------------------------------------
    // Backlight
    // --------------------------------------------------------

    {
      auto cfg = _light_instance.config();

      cfg.pin_bl = 27;
      cfg.invert = false;
      cfg.freq = 1200;
      cfg.pwm_channel = 7;

      _light_instance.config(cfg);
      _panel_instance.setLight(&_light_instance);
    }

    setPanel(&_panel_instance);
  }
};

// ============================================================
// HARDWARE OBJECTS
// ============================================================

LGFX display;
SPIClass SDSPI(VSPI);

// ============================================================
// SD CARD CONFIGURATION
// ============================================================

static constexpr int SD_CS = 5;
static constexpr int SD_SCLK = 18;
static constexpr int SD_MISO = 19;
static constexpr int SD_MOSI = 23;

// ============================================================
// ASSET PATHS
// ============================================================

static const char* BACKGROUND_PATH =
  "/assets/background/default.png";

static const char* EYES_NEUTRAL_PATH =
  "/assets/eyes/neutral.png";

static const char* EYES_BLINK_PATH =
  "/assets/eyes/blink.png";

static const char* MOUTH_EXPRESSIONLESS_PATH =
  "/assets/mouth/expressionless.png";

// ============================================================
// FACE LAYOUT
//
// Eyes canvas:  480 x 160
// Mouth canvas: 480 x 120
//
// Eyes and mouth intentionally overlap vertically.
// This creates the compact BMO ._. face layout.
// ============================================================

static constexpr int EYES_BASE_X = 0;
static constexpr int EYES_BASE_Y = 20;

static constexpr int MOUTH_BASE_X = 0;
static constexpr int MOUTH_BASE_Y = 100;

// ============================================================
// ANIMATION SETTINGS
// ============================================================

static constexpr unsigned long BLINK_DURATION_MS = 120;

static constexpr unsigned long BLINK_MIN_DELAY_MS = 3000;
static constexpr unsigned long BLINK_MAX_DELAY_MS = 8000;

static constexpr unsigned long MOVEMENT_MIN_DELAY_MS = 1500;
static constexpr unsigned long MOVEMENT_MAX_DELAY_MS = 4000;

// Maximum eye movement radius
static constexpr int MAX_EYE_OFFSET_X = 2;
static constexpr int MAX_EYE_OFFSET_Y = 1;

// Time between individual 1-pixel movement steps
static constexpr unsigned long EYE_STEP_INTERVAL_MS = 80;

// ============================================================
// ANIMATION STATE
// ============================================================

int eyeOffsetX = 0;
int eyeOffsetY = 0;

int targetEyeOffsetX = 0;
int targetEyeOffsetY = 0;

bool isBlinking = false;
bool faceNeedsRedraw = true;
bool setupComplete = false;

unsigned long blinkStartedAt = 0;
unsigned long nextBlinkAt = 0;

unsigned long nextEyeTargetAt = 0;
unsigned long lastEyeStepAt = 0;

// ============================================================
// FILE CHECK
// ============================================================

bool fileExists(const char* path)
{
  File file = SD.open(path, FILE_READ);

  if (!file)
  {
    Serial.print("Missing file: ");
    Serial.println(path);

    return false;
  }

  Serial.print("Found: ");
  Serial.print(path);
  Serial.print(" | Size: ");
  Serial.print(file.size());
  Serial.println(" bytes");

  file.close();

  return true;
}

// ============================================================
// DRAW PNG FROM SD
//
// The file is loaded into memory first.
// This avoids LovyanGFX's incompatible SDFS DataWrapper path.
// ============================================================

bool drawPngFromSD(
  const char* path,
  int32_t x,
  int32_t y
)
{
  File file = SD.open(path, FILE_READ);

  if (!file)
  {
    Serial.print("Could not open PNG: ");
    Serial.println(path);

    return false;
  }

  size_t fileSize = file.size();

  if (fileSize == 0)
  {
    Serial.print("PNG file is empty: ");
    Serial.println(path);

    file.close();
    return false;
  }

  uint8_t* pngData =
    static_cast<uint8_t*>(malloc(fileSize));

  if (pngDa*a == nullptr)
  {
    Serial.print*"Not enough memory for PNG: ");
  * Serial.print(path);
    Serial.pr*nt(" | Required: ");
    Serial.pr*nt(fileSize);
    Serial.println("*bytes");

    file.close();
    re*urn false;
  }

  size_t bytesRead = file.read(
    pngData,
    fileSize
  );

  file.close();

  if (bytesRead != fileSize)
  {
    Serial.print("Incomplete PNG read: ");
    Serial.print(path);
    Serial.print(" | Expected: ");
    Serial.print(fileSize);
    Serial.print(" | Read: ");
    Serial.println(bytesRead);

    free(pngData);
    return false;
  }

  bool result = display.drawPng(
    pngData,
    fileSize,
    x,
    y
  );

  free(pngData);

  if (!result)
  {
    Serial.print("PNG decoding failed: ");
    Serial.println(path);

    return false;
  }

  return true;
}

// ============================================================
// ERROR SCREEN
// ============================================================

void showErrorScreen(
  const char* title,
  const char* message
)
{
  display.fillScreen(
    display.color565(20, 20, 20)
  );

  display.setTextColor(
    display.color565(255, 80, 80)
  );

  display.setTextSize(2);
  display.setCursor(20, 30);

  display.println(title);
  display.println();

  display.setTextColor(
    display.color565(255, 255, 255)
  );

  display.println(message);
  display.println();
  display.println("Check Serial Monitor.");
}

// ============================================================
// DRAW COMPLETE FACE
//
// Background is always redrawn first.
// This prevents transparent PNGs from leaving trails when the
// eyes move by one or two pixels.
// ============================================================

bool drawFace()
{
  bool success = true;

  display.startWrite();

  // Layer 0: Full-screen background
  success &= drawPngFromSD(
    BACKGROUND_PATH,
    0,
    0
  );

  // Layer 1: Mouth
  success &= drawPngFromSD(
    MOUTH_EXPRESSIONLESS_PATH,
    MOUTH_BASE_X,
    MOUTH_BASE_Y
  );

  // Layer 2: Eyes
  const char* currentEyesPath =
    isBlinking
      ? EYES_BLINK_PATH
      : EYES_NEUTRAL_PATH;

  success &= drawPngFromSD(
    currentEyesPath,
    EYES_BASE_X + eyeOffsetX,
    EYES_BASE_Y + eyeOffsetY
  );

  display.endWrite();

  faceNeedsRedraw = false;

  return success;
}

// ============================================================
// BLINK SYSTEM
// ============================================================

void scheduleNextBlink()
{
  nextBlinkAt =
    millis() +
    random(
      BLINK_MIN_DELAY_MS,
      BLINK_MAX_DELAY_MS + 1
    );
}

void startBlink()
{
  isBlinking = true;
  blinkStartedAt = millis();
  faceNeedsRedraw = true;

  Serial.println("Blink");
}

void updateBlink()
{
  unsigned long now = millis();

  if (!isBlinking && now >= nextBlinkAt)
  {
    startBlink();
    return;
  }

  if (
    isBlinking &&
    now - blinkStartedAt >= BLINK_DURATION_MS
  )
  {
    isBlinking = false;
    faceNeedsRedraw = true;

    scheduleNextBlink();
  }
}

// ============================================================
// EYE MOVEMENT SYSTEM
// ============================================================

void chooseNewEyeTarget()
{
  targetEyeOffsetX = random(
    -MAX_EYE_OFFSET_X,
    MAX_EYE_OFFSET_X + 1
  );

  targetEyeOffsetY = random(
    -MAX_EYE_OFFSET_Y,
    MAX_EYE_OFFSET_Y + 1
  );

  nextEyeTargetAt =
    millis() +
    random(
      MOVEMENT_MIN_DELAY_MS,
      MOVEMENT_MAX_DELAY_MS + 1
    );

  Serial.print("Eye target: ");
  Serial.print(targetEyeOffsetX);
  Serial.print(", ");
  Serial.println(targetEyeOffsetY);
}

void updateEyeMovement()
{
  unsigned long now = millis();

  if (now >= nextEyeTargetAt)
  {
    chooseNewEyeTarget();
  }

  if (
    now - lastEyeStepAt <
    EYE_STEP_INTERVAL_MS
  )
  {
    return;
  }

  lastEyeStepAt = now;

  bool moved = false;

  if (eyeOffsetX < targetEyeOffsetX)
  {
    eyeOffsetX++;
    moved = true;
  }
  else if (eyeOffsetX > targetEyeOffsetX)
  {
    eyeOffsetX--;
    moved = true;
  }

  if (eyeOffsetY < targetEyeOffsetY)
  {
    eyeOffsetY++;
    moved = true;
  }
  else if (eyeOffsetY > targetEyeOffsetY)
  {
    eyeOffsetY--;
    moved = true;
  }

  if (moved)
  {
    faceNeedsRedraw = true;
  }
}

// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);

  // Required for reliable Serial Monitor startup
  delay(2000);

  Serial.println();
  Serial.println("=== BMO BLINK TEST ===");

  // ----------------------------------------------------------
  // Initialize display
  // ----------------------------------------------------------

  display.init();

  // Landscape orientation: 480 x 320
  display.setRotation(1);

  display.setBrightness(180);
  display.setColorDepth(16);
  display.setSwapBytes(true);

  display.fillScreen(
    display.color565(0, 0, 0)
  );

  Serial.print("Display: ");
  Serial.print(display.width());
  Serial.print(" x ");
  Serial.println(display.height());

  // ----------------------------------------------------------
  // Initialize SD card
  // ----------------------------------------------------------

  pinMode(SD_CS, OUTPUT);
  digitalWrite(SD_CS, HIGH);

  SDSPI.begin(
    SD_SCLK,
    SD_MISO,
    SD_MOSI,
    SD_CS
  );

  SDSPI.setFrequency(1000000);

  if (!SD.begin(SD_CS, SDSPI))
  {
    Serial.println("SD initialization failed.");

    showErrorScreen(
      "SD ERROR",
      "Could not initialize SD card."
    );

    return;
  }

  Serial.println("SD initialized.");

  // ----------------------------------------------------------
  // Verify required assets
  // ----------------------------------------------------------

  bool allAssetsFound = true;

  allAssetsFound &=
    fileExists(BACKGROUND_PATH);

  allAssetsFound &=
    fileExists(EYES_NEUTRAL_PATH);

  allAssetsFound &=
    fileExists(EYES_BLINK_PATH);

  allAssetsFound &=
    fileExists(MOUTH_EXPRESSIONLESS_PATH);

  if (!allAssetsFound)
  {
    showErrorScreen(
      "ASSET ERROR",
      "One or more PNG files are missing."
    );

    return;
  }

  Serial.println("All required assets found.");

  // ----------------------------------------------------------
  // Initialize animation
  // ----------------------------------------------------------

  randomSeed(esp_random());

  scheduleNextBlink();

  nextEyeTargetAt =
    millis() +
    random(1000, 2501);

  if (!drawFace())
  {
    showErrorScreen(
      "PNG ERROR",
      "Could not decode one or more PNGs."
    );

    return;
  }

  setupComplete = true;

  Serial.println("BMO is alive.");
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop()
{
  if (!setupComplete)
  {
    delay(100);
    return;
  }

  updateBlink();
  updateEyeMovement();

  if (faceNeedsRedraw)
  {
    if (!drawFace())
    {
      setupComplete = false;

      showErrorScreen(
        "RENDER ERROR",
        "BMO face rendering failed."
      );
    }
  }

  delay(20);
}
