void setup()
{
  Serial.begin(115200);
  delay(2000);

  pinMode(21, INPUT_PULLUP);
  pinMode(22, INPUT_PULLUP);
  pinMode(35, INPUT);

  Serial.println("GPIO TEST");
}

void loop()
{
  Serial.print("21=");
  Serial.print(digitalRead(21));

  Serial.print(" 22=");
  Serial.print(digitalRead(22));

  Serial.print(" 35=");
  Serial.println(digitalRead(35));

  delay(1000);
}
