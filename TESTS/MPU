#define LGFX_USE_V1

#include <Arduino.h>
#include <LovyanGFX.hpp>
#include <SPI.h>
#include <SD.h>

// ============================================================
// DISPLAY CONFIGURATION
// Board: ESP32-3248S035C
// Display: ST7796
// Landscape resolution: 480 x 320
// ============================================================

class LGFX : public lgfx::LGFX_Device
{
  lgfx::Panel_ST7796 panel;
  lgfx::Bus_SPI bus;
  lgfx::Light_PWM backlight;

public:
  LGFX()
  {
    // Display SPI bus
    {
      auto cfg = bus.config();

      cfg.spi_host = HSPI_HOST;
      cfg.spi_mode = 0;
      cfg.freq_write = 80000000;
      cfg.freq_read = 40000000;
      cfg.spi_3wire = true;
      cfg.use_lock = true;
      cfg.dma_channel = SPI_DMA_CH_AUTO;

      cfg.pin_sclk = 14;
      cfg.pin_mosi = 13;
      cfg.pin_miso = 12;
      cfg.pin_dc = 2;

      bus.config(cfg);
      panel.setBus(&bus);
    }

    // ST7796 display panel
    {
      auto cfg = panel.config();

      cfg.pin_cs = 15;
      cfg.pin_rst = -1;
      cfg.pin_busy = -1;

      cfg.panel_width = 320;
      cfg.panel_height = 480;

      cfg.offset_x = 0;
      cfg.offset_y = 0;
      cfg.offset_rotation = 0;

      cfg.dummy_read_pixel = 8;
      cfg.dummy_read_bits = 1;

      cfg.readable = true;
      cfg.invert = false;
      cfg.rgb_order = false;
      cfg.dlen_16bit = false;
      cfg.bus_shared = true;

      panel.config(cfg);
    }

    // Display backlight
    {
      auto cfg = backlight.config();

      cfg.pin_bl = 27;
      cfg.invert = false;
      cfg.freq = 1200;
      cfg.pwm_channel = 7;

      backlight.config(cfg);
      panel.setLight(&backlight);
    }

    setPanel(&panel);
  }
};

// ============================================================
// HARDWARE OBJECTS
// ============================================================

LGFX display;
SPIClass SDSPI(VSPI);

// ============================================================
// SD CARD CONFIGURATION
// ============================================================

static constexpr int SD_CS = 5;
static constexpr int SD_SCLK = 18;
static constexpr int SD_MISO = 19;
static constexpr int SD_MOSI = 23;

// ============================================================
// ANIMATION DEFINITIONS
//
// highestFrame is inclusive.
//
// booting:   0000 through 0009
// idle:      0000 through 0007
// blinkidle: 0000 through 0007
// ============================================================

struct Animation
{
  const char* folder;
  const char* filePrefix;
  int firstFrame;
  int highestFrame;
  unsigned long frameDurationMs;
  bool pingPong;
};

Animation bootingAnimation =
{
  "/assets/booting",
  "booting",
  0,
  9,
  350,
  false
};

Animation idleAnimation =
{
  "/assets/idle",
  "idle",
  0,
  7,
  50,
  true
};

Animation blinkIdleAnimation =
{
  "/assets/blinkidle",
  "blinkidle",
  0,
  2,
  50,
  false
};

// ============================================================
// CURRENT ANIMATION STATE
// ============================================================

enum AnimationMode
{
  MODE_BOOTING,
  MODE_IDLE,
  MODE_BLINK_IDLE
};

AnimationMode currentMode = MODE_BOOTING;

int currentFrame = 0;
int frameDirection = 1;

unsigned long lastFrameAt = 0;
unsigned long nextBlinkAt = 0;

bool setupComplete = false;

// ============================================================
// ERROR SCREEN
// ============================================================

void showError(
  const char* title,
  const char* message
)
{
  display.fillScreen(
    display.color565(20, 20, 20)
  );

  display.setTextSize(2);

  display.setTextColor(
    display.color565(255, 80, 80)
  );

  display.setCursor(20, 30);
  display.println(title);

  display.setTextColor(
    display.color565(255, 255, 255)
  );

  display.setCursor(20, 75);
  display.println(message);

  display.setCursor(20, 120);
  display.println("Check Serial Monitor.");
}

// ============================================================
// GET CURRENT ANIMATION
// ============================================================

Animation* getCurrentAnimation()
{
  switch (currentMode)
  {
    case MODE_BOOTING:
      return &bootingAnimation;

    case MODE_IDLE:
      return &idleAnimation;

    case MODE_BLINK_IDLE:
      return &blinkIdleAnimation;
  }

  return &idleAnimation;
}

// ============================================================
// BUILD FRAME PATH
//
// Example:
// /assets/idle/idle0003.png
// ============================================================

void buildFramePath(
  const Animation& animation,
  int frameNumber,
  char* outputPath,
  size_t outputPathSize
)
{
  snprintf(
    outputPath,
    outputPathSize,
    "%s/%s%04d.png",
    animation.folder,
    animation.filePrefix,
    frameNumber
  );
}

// ============================================================
// DRAW PNG FRAME FROM SD
// ============================================================

bool drawPngFrame(const char* path)
{
  File pngFile = SD.open(path, FILE_READ);

  if (!pngFile)
  {
    Serial.print("FRAME NOT FOUND: ");
    Serial.println(path);
    return false;
  }

  size_t pngSize = pngFile.size();

  if (pngSize == 0)
  {
    Serial.print("FRAME IS EMPTY: ");
    Serial.println(path);

    pngFile.close();
    return false;
  }

  uint8_t* pngBuffer =
    static_cast<uint8_t*>(malloc(pngSize));

  if (pngBuffer == nullptr)
  {
    Serial.print("FRAME MEMORY FAILED: ");
    Serial.println(path);

    Serial.print("Required bytes: ");
    Serial.println(pngSize);

    Serial.print("Free heap: ");
    Serial.println(ESP.getFreeHeap());

    pngFile.close();
    return false;
  }

  size_t bytesRead = pngFile.read(
    pngBuffer,
    pngSize
  );

  unsigned long t0 = millis();
  Serial.print("Read: ");
  Serial.println(millis() - t0);

  pngFile.close();

  if (bytesRead != pngSize)
  {
    Serial.print("FRAME READ INCOMPLETE: ");
    Serial.println(path);

    Serial.print("Expected bytes: ");
    Serial.println(pngSize);

    Serial.print("Read bytes: ");
    Serial.println(bytesRead);

    free(pngBuffer);
    return false;
  }

  bool drawResult = display.drawPng(
    pngBuffer,
    pngSize,
    0,
    0
  );

  free(pngBuffer);

  if (!drawResult)
  {
    Serial.print("FRAME DECODE FAILED: ");
    Serial.println(path);

    return false;
  }

  Serial.print("Total: ");
  Serial.println(millis() - t0);

  return true;
}

// ============================================================
// DRAW CURRENT FRAME
// ============================================================

bool drawCurrentFrame()
{
  Animation* animation = getCurrentAnimation();

  char framePath[96];

  buildFramePath(
    *animation,
    currentFrame,
    framePath,
    sizeof(framePath)
  );

  Serial.print("Drawing: ");
  Serial.println(framePath);

  unsigned long t0 = millis();
  bool result = drawPngFrame(framePath);

  Serial.print("Frame render time: ");
  Serial.println(millis() - t0);

  return result;

  return drawPngFrame(framePath);
}

// ============================================================
// VERIFY ANIMATION FILES
//
// Checks the first and last frame of each required animation.
// ============================================================

bool verifyAnimation(const Animation& animation)
{
  char firstPath[96];
  char lastPath[96];

  buildFramePath(
    animation,
    animation.firstFrame,
    firstPath,
    sizeof(firstPath)
  );

  buildFramePath(
    animation,
    animation.highestFrame,
    lastPath,
    sizeof(lastPath)
  );

  File firstFile = SD.open(firstPath, FILE_READ);

  if (!firstFile)
  {
    Serial.print("FIRST FRAME MISSING: ");
    Serial.println(firstPath);
    return false;
  }

  firstFile.close();

  File lastFile = SD.open(lastPath, FILE_READ);

  if (!lastFile)
  {
    Serial.print("LAST FRAME MISSING: ");
    Serial.println(lastPath);
    return false;
  }

  lastFile.close();

  Serial.print("Animation verified: ");
  Serial.print(animation.filePrefix);

  Serial.print(" | Frames ");
  Serial.print(animation.firstFrame);

  Serial.print(" to ");
  Serial.println(animation.highestFrame);

  return true;
}

// ============================================================
// BLINK SCHEDULING
// ============================================================

void scheduleNextBlink()
{
  nextBlinkAt =
    millis() + random(5000, 10001);

  Serial.print("Next blink in ");
  Serial.print(nextBlinkAt - millis());
  Serial.println(" ms");
}

// ============================================================
// START ANIMATION MODES
// ======

// ============================================================

void startBooting()
{
  currentMode = MODE_BOOTING;
  currentFrame = bootingAnimation.firstFrame;
  frameDirection = 1;
  lastFrameAt = millis();

  Serial.println("Animation: BOOTING");
}

void startIdle()
{
  currentMode = MODE_IDLE;
  currentFrame = idleAnimation.firstFrame;
  frameDirection = 1;
  lastFrameAt = millis();

  scheduleNextBlink();

  Serial.println("Animation: IDLE");
}

void startBlinkIdle()
{
  currentMode = MODE_BLINK_IDLE;
  currentFrame = blinkIdleAnimation.firstFrame;
  frameDirection = 1;
  lastFrameAt = millis();

  Serial.println("Animation: BLINK IDLE");
}

// ============================================================
// ADVANCE CURRENT ANIMATION
// ============================================================

void advanceAnimation()
{
  Animation* animation = getCurrentAnimation();

  // Booting plays once, then changes to Idle.
  if (currentMode == MODE_BOOTING)
  {
    currentFrame++;

    if (currentFrame > animation->highestFrame)
    {
      startIdle();
    }

    return;
  }

  // BlinkIdle plays once, then changes to Idle.
  if (currentMode == MODE_BLINK_IDLE)
  {
    currentFrame++;

    if (currentFrame > animation->highestFrame)
    {
      startIdle();
    }

    return;
  }

  // Idle runs as a ping-pong loop:
  // 0000 -> 0001 -> ... -> 0007 -> 0006 -> ... -> 0000
  if (currentMode == MODE_IDLE)
  {
    currentFrame += frameDirection;

    if (currentFrame >= animation->highestFrame)
    {
      currentFrame = animation->highestFrame;
      frameDirection = -1;
    }
    else if (currentFrame <= animation->firstFrame)
    {
      currentFrame = animation->firstFrame;
      frameDirection = 1;
    }
  }
}

// ============================================================
// UPDATE ANIMATION PLAYER
// ============================================================

void updateAnimation()
{
  unsigned long now = millis();

  // Trigger a random blink while Idle is active.
  if (
    currentMode == MODE_IDLE &&
    now >= nextBlinkAt
  )
  {
    startBlinkIdle();

    if (!drawCurrentFrame())
    {
      setupComplete = false;

      showError(
        "FRAME ERROR",
        "Could not draw blink frame."
      );
    }

    return;
  }

  Animation* animation = getCurrentAnimation();

  if (
    now - lastFrameAt <
    animation->frameDurationMs
  )
  {
    return;
  }

  lastFrameAt = now;

  advanceAnimation();

  if (!drawCurrentFrame())
  {
    setupComplete = false;

    showError(
      "FRAME ERROR",
      "Could not draw animation frame."
    );
  }
}

// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);
  delay(2000);

  Serial.println();
  Serial.println("=== BMO FRAME ANIMATION TEST ===");

  // ----------------------------------------------------------
  // Initialize display
  // ----------------------------------------------------------

  display.init();
  display.setRotation(1);
  display.setBrightness(180);
  display.setColorDepth(16);
  display.setSwapBytes(true);

  display.fillScreen(
    display.color565(0, 0, 0)
  );

  Serial.print("Display size: ");
  Serial.print(display.width());
  Serial.print(" x ");
  Serial.println(display.height());

  // ----------------------------------------------------------
  // Initialize SD card
  // ----------------------------------------------------------

  pinMode(SD_CS, OUTPUT);
  digitalWrite(SD_CS, HIGH);

  SDSPI.begin(
    SD_SCLK,
    SD_MISO,
    SD_MOSI,
    SD_CS
  );

  SDSPI.setFrequency(1000000);

  if (!SD.begin(SD_CS, SDSPI))
  {
    Serial.println("SD INITIALIZATION FAILED");

    showError(
      "SD ERROR",
      "Could not initialize SD card."
    );

    return;
  }

  Serial.println("SD initialized.");

  // ----------------------------------------------------------
  // Verify required animations
  // ----------------------------------------------------------

  bool animationsValid = true;

  animationsValid &=
    verifyAnimation(bootingAnimation);

  animationsValid &=
    verifyAnimation(idleAnimation);

  animationsValid &=
    verifyAnimation(blinkIdleAnimation);

  if (!animationsValid)
  {
    showError(
      "ASSET ERROR",
      "Animation frames are missing."
    );

    return;
  }

  Serial.println("All required animations verified.");

  // ----------------------------------------------------------
  // Initialize randomness
  // ----------------------------------------------------------

  randomSeed(esp_random());

  // ----------------------------------------------------------
  // Start boot animation
  // ----------------------------------------------------------

  startBooting();

  if (!drawCurrentFrame())
  {
    showError(
      "FRAME ERROR",
      "Could not draw first boot frame."
    );

    return;
  }

  setupComplete = true;

  Serial.println("BMO animation player running.");
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop()
{
  if (!setupComplete)
  {
    delay(100);
    return;
  }

  updateAnimation();

  delay(1);
}
