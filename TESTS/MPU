#define LGFX_USE_V1

#include <Arduino.h>
#include <LovyanGFX.hpp>

#include <SPI.h>
#include <SD.h>
#include <FS.h>

#include <Wire.h>
#include <driver/i2c.h>

// ============================================================
// DISPLAY HARDWARE CONFIGURATION
// Board: ESP32-3248S035C
// Display: ST7796
// Native resolution: 320 x 480
// BMO orientation: 480 x 320 landscape
// ============================================================

class LGFX : public lgfx::LGFX_Device
{
  lgfx::Panel_ST7796 _panel_instance;
  lgfx::Bus_SPI _bus_instance;
  lgfx::Light_PWM _light_instance;

public:
  LGFX(void)
  {
    // --------------------------------------------------------
    // Display SPI bus
    // --------------------------------------------------------

    {
      auto cfg = _bus_instance.config();

      cfg.spi_host = HSPI_HOST;
      cfg.spi_mode = 0;

      cfg.freq_write = 80000000;
      cfg.freq_read = 40000000;

      cfg.spi_3wire = true;
      cfg.use_lock = true;
      cfg.dma_channel = SPI_DMA_CH_AUTO;

      cfg.pin_sclk = 14;
      cfg.pin_mosi = 13;
      cfg.pin_miso = 12;
      cfg.pin_dc = 2;

      _bus_instance.config(cfg);
      _panel_instance.setBus(&_bus_instance);
    }

    // --------------------------------------------------------
    // ST7796 display panel
    // --------------------------------------------------------

    {
      auto cfg = _panel_instance.config();

      cfg.pin_cs = 15;
      cfg.pin_rst = -1;
      cfg.pin_busy = -1;

      cfg.panel_width = 320;
      cfg.panel_height = 480;

      cfg.offset_x = 0;
      cfg.offset_y = 0;
      cfg.offset_rotation = 0;

      cfg.dummy_read_pixel = 8;
      cfg.dummy_read_bits = 1;

      cfg.readable = true;
      cfg.invert = false;
      cfg.rgb_order = false;
      cfg.dlen_16bit = false;
      cfg.bus_shared = true;

      _panel_instance.config(cfg);
    }

    // --------------------------------------------------------
    // Backlight
    // --------------------------------------------------------

    {
      auto cfg = _light_instance.config();

      cfg.pin_bl = 27;
      cfg.invert = false;
      cfg.freq = 1200;
      cfg.pwm_channel = 7;

      _light_instance.config(cfg);
      _panel_instance.setLight(&_light_instance);
    }

    setPanel(&_panel_instance);
  }
};

// ============================================================
// HARDWARE OBJECTS
// ============================================================

LGFX display;

SPIClass SDSPI(VSPI);

// ============================================================
// SD CARD CONFIGURATION
// ============================================================

static constexpr int SD_CS = 5;
static constexpr int SD_SCLK = 18;
static constexpr int SD_MISO = 19;
static constexpr int SD_MOSI = 23;

// ============================================================
// ASSET PATHS
// ============================================================

static const char* BACKGROUND_PATH =
  "/assets/background/default.png";

static const char* EYES_NEUTRAL_PATH =
  "/assets/eyes/neutral.png";

static const char* EYES_BLINK_PATH =
  "/assets/eyes/blink.png";

static const char* MOUTH_PATH =
  "/assets/mouth/expressionless.png";

// ============================================================
// FACE LAYOUT
// PNG canvas sizes:
//
// Eyes:  480 x 160
// Mouth: 480 x 120
//
// Mouth is intentionally close to the eyes for a ._. layout.
// ============================================================

static constexpr int EYES_BASE_X = 0;
static constexpr int EYES_BASE_Y = 25;

static constexpr int MOUTH_BASE_X = 0;
static constexpr int MOUTH_BASE_Y = 115;

// ============================================================
// ANIMATION STATE
// ============================================================

int eyeOffsetX = 0;
int eyeOffsetY = 0;

int targetEyeOffsetX = 0;
int targetEyeOffsetY = 0;

bool isBlinking = false;
bool faceNeedsRedraw = true;

unsigned long blinkStartedAt = 0;
unsigned long nextBlinkAt = 0;
unsigned long nextEyeMovementAt = 0;

// Blink duration in milliseconds
static constexpr unsigned long BLINK_DURATION = 110;

// ============================================================
// FILE CHECK
// ============================================================

bool fileExists(const char* path)
{
  File file = SD.open(path);

  if (!file)
  {
    Serial.print("Missing file: ");
    Serial.println(path);

    return false;
  }

  file.close();
  return true;
}

// ============================================================
// DRAW PNG FILE
// ============================================================

bool drawPng(
  const char* path,
  int x,
  int y
)
{
  bool result = display.drawPngFile(
    SD,
    path,
    x,
    y
  );

  if (!result)
  {
    Serial.print("Failed to draw PNG: ");
    Serial.println(path);
  }

  return result;
}

// ============================================================
// COMPLETE FACE REDRAW
//
// The complete face is redrawn whenever the eyes move or blink.
// This prevents transparent PNG layers from leaving old pixels
// behind at the previous position.
// ============================================================

void drawFace()
{
  display.startWrite();

  // Layer 0: Background
  drawPng(
    BACKGROUND_PATH,
    0,
    0
  );

  // Layer 1: Mouth
  drawPng(
    MOUTH_PATH,
    MOUTH_BASE_X,
    MOUTH_BASE_Y
  );

  // Layer 2: Eyes
  if (isBlinking)
  {
    drawPng(
      EYES_BLINK_PATH,
      EYES_BASE_X + eyeOffsetX,
      EYES_BASE_Y + eyeOffsetY
    );
  }
  else
  {
    drawPng(
      EYES_NEUTRAL_PATH,
      EYES_BASE_X + eyeOffsetX,
      EYES_BASE_Y + eyeOffsetY
    );
  }

  display.endWrite();

  faceNeedsRedraw = false;
}

// ============================================================
// UI FOR MISSING ASSETS
// ============================================================

void showAssetError()
{
  display.fillScreen(
    display.color565(25, 25, 25)
  );

  display.setTextColor(
    display.color565(255, 80, 80)
  );

  display.setTextSize(2);
  display.setCursor(20, 30);

  display.println("BMO ASSET ERROR");
  display.println();
  display.println("Check Serial Monitor");
  display.println("for missing files.");
}

// ============================================================
// BLINK ANIMATION
// ============================================================

void startBlink()
{
  if (isBlinking)
  {
    return;
  }

  isBlinking = true;
  blinkStartedAt = millis();

  faceNeedsRedraw = true;

  Serial.println("BMO blink");
}

void updateBlink()
{
  unsigned long now = millis();

  if (!isBlinking && now >= nextBlinkAt)
  {
    startBlink();
  }

  if (
    isBlinking &&
    now - blinkStartedAt >= BLINK_DURATION
  )
  {
    isBlinking = false;

    // Next blink after 3 to 8 seconds
    nextBlinkAt = now + random(3000, 8001);

    faceNeedsRedraw = true;
  }
}

// ============================================================
// SUBTLE EYE MOVEMENT
// ============================================================

void chooseNewEyeTarget()
{
  // Very subtle movement
  targetEyeOffsetX = random(-2, 3);
  targetEyeOffsetY = random(-1, 2);

  // Wait between 1.5 and 4 seconds before choosing
  // another target
  nextEyeMovementAt =
    millis() + random(1500, 4001);
}

void updateEyeMovement()
{
  unsigned long now = millis();

  if (now >= nextEyeMovementAt)
  {
    chooseNewEyeTarget();
  }

  bool moved = false;

  if (eyeOffsetX < targetEyeOffsetX)
  {
    eyeOffsetX++;
    moved = true;
  }
  else if (eyeOffsetX > targetEyeOffsetX)
  {
    eyeOffsetX--;
    moved = true;
  }

  if (eyeOffsetY < targetEyeOffsetY)
  {
    eyeOffsetY++;
    moved = true;
  }
  else if (eyeOffsetY > targetEyeOffsetY)
  {
    eyeOffsetY--;
    moved = true;
  }

  if (moved)
  {
    faceNeedsRedraw = true;
  }
}

// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);

  // Required so early messages are visible in Serial Monitor
  delay(2000);

  Serial.println();
  Serial.println("=== BMO FACE TEST ===");

  // ----------------------------------------------------------
  // Initialize display
  // ----------------------------------------------------------

  display.init();

  // Landscape orientation
  display.setRotation(1);

  display.setBrightness(180);
  display.setColorDepth(16);
  display.setSwapBytes(true);

  display.fillScreen(
    display.color565(0, 0, 0)
  );

  Serial.print("Display size: ");
  Serial.print(display.width());
  Serial.print(" x ");
  Serial.println(display.height());

  // ----------------------------------------------------------
  // Initialize SD card
  // ----------------------------------------------------------

  pinMode(SD_CS, OUTPUT);
  digitalWrite(SD_CS, HIGH);

  SDSPI.begin(
    SD_SCLK,
    SD_MISO,
    SD_MOSI,
    SD_CS
  );

  SDSPI.setFrequency(1000000);

  if (!SD.begin(SD_CS, SDSPI))
  {
    Serial.println("SD initialization failed.");

    display.setTextColor(
      display.color565(255, 80, 80)
    );

    display.setTextSize(2);
    display.setCursor(20, 30);
    display.println("SD CARD ERROR");

    return;
  }

  Serial.println("SD initialized.");

  // ----------------------------------------------------------
  // Check required BMO assets
  // ----------------------------------------------------------

  bool assetsAvailable = true;

  assetsAvailable &=
    fileExists(BACKGROUND_PATH);

  assetsAvailable &=
    fileExists(EYES_NEUTRAL_PATH);

  assetsAvailable &=
    fileExists(EYES_BLINK_PATH);

  assetsAvailable &=
    fileExists(MOUTH_PATH);

  if (!assetsAvailable)
  {
    showAssetError();
    return;
  }

  Serial.println("All BMO assets found.");

  // ----------------------------------------------------------
  // Initialize animation timing
  // ----------------------------------------------------------

  randomSeed(esp_random());

  nextBlinkAt =
    millis() + random(2000, 5001);

  nextEyeMovementAt =
    millis() + random(1000, 2501);

  // Initial face
  drawFace();

  Serial.println("BMO face running.");
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop()
{
  updateBlink();
  updateEyeMovement();

  if (faceNeedsRedraw)
  {
    drawFace();
  }

  delay(20);
}
