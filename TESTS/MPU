LGFX_Sprite eyeSprite(&display);

eyeSprite.setColorDepth(16);

if (!eyeSprite.createSprite(480, 160))
{
  Serial.println("EYE SPRITE FAILED");
  return;
}

eyeSprite.fillSprite(TFT_BLACK);

drawAssetToFrame(
  neutralEyesAsset,
  0,
  0
);

eyeSprite.pushSprite(
  0,
  20,
  TFT_BLACK
);

eyeSprite.deleteSprite();
