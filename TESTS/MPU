#include <Arduino.h>
#include <WiFi.h>
#include <SPI.h>
#include <SD.h>

#include "AudioFileSourceSD.h"
#include "AudioFileSourceID3.h"
#include "AudioGeneratorMP3.h"
#include "AudioOutputInternalDAC.h"

// ============================================================
// SD card configuration
// ============================================================

static constexpr int SD_CS = 5;
static constexpr int SD_SCLK = 18;
static constexpr int SD_MISO = 19;
static constexpr int SD_MOSI = 23;

SPIClass SDSPI(VSPI);

// ============================================================
// Audio objects
// ============================================================

AudioFileSourceSD* audioFile = nullptr;
AudioFileSourceID3* id3Source = nullptr;
AudioGeneratorMP3* mp3Decoder = nullptr;
AudioOutputInternalDAC* audioOutput = nullptr;

// ============================================================
// Playback state
// ============================================================

bool playbackStarted = false;
bool playbackFinished = false;

// ============================================================
// Setup
// ============================================================

void setup()
{
  Serial.begin(115200);
  delay(2000);

  Serial.println();
  Serial.println("=== BMO INTERNAL DAC MP3 TEST ===");

  WiFi.mode(WIFI_OFF);

  // ----------------------------------------------------------
  // Initialize SD card
  // ----------------------------------------------------------

  pinMode(SD_CS, OUTPUT);
  digitalWrite(SD_CS, HIGH);

  SDSPI.begin(
    SD_SCLK,
    SD_MISO,
    SD_MOSI,
    SD_CS
  );

  SDSPI.setFrequency(1000000);

  if (!SD.begin(SD_CS, SDSPI))
  {
    Serial.println("SD initialization failed.");
    return;
  }

  Serial.println("SD initialized.");

  // ----------------------------------------------------------
  // Confirm MP3 file
  // ----------------------------------------------------------

  File testFile = SD.open("/test.mp3");

  if (!testFile)
  {
    Serial.println("File not found: /test.mp3");
    return;
  }

  Serial.print("MP3 file found. Size: ");
  Serial.print(testFile.size());
  Serial.println(" bytes");

  testFile.close();

  // ----------------------------------------------------------
  // Create MP3 pipeline
  // ----------------------------------------------------------

  audioFile = new AudioFileSourceSD("/test.mp3");
  id3Source = new AudioFileSourceID3(audioFile);

  // This is the important change:
  // Use the ESP32 internal DAC instead of normal I2S output.
  audioOutput = new AudioOutputInternalDAC(256);

  // Start extremely quietly.
  audioOutput->SetGain(0.01);

  mp3Decoder = new AudioGeneratorMP3();

  Serial.println("Starting MP3 decoder...");

  playbackStarted = mp3Decoder->begin(
    id3Source,
    audioOutput
  );

  if (!playbackStarted)
  {
    Serial.println("MP3 decoder failed to start.");
    return;
  }

  Serial.println("MP3 playback started.");
}

// ============================================================
// Main loop
// ============================================================

void loop()
{
  if (!playbackStarted || playbackFinished)
  {
    delay(100);
    return;
  }

  if (mp3Decoder->isRunning())
  {
    if (!mp3Decoder->loop())
    {
      mp3Decoder->stop();
      playbackFinished = true;

      Serial.println("MP3 playback finished or stopped.");
    }
  }
  else
  {
    playbackFinished = true;
    Serial.println("MP3 playback completed.");
  }
}
