void loop()
{
  int32_t sample[128];
  size_t bytesRead;

  i2s_read(
      I2S_NUM_0,
      sample,
      sizeof(sample),
      &bytesRead,
      portMAX_DELAY);

  long peak = 0;

  for (int i = 0; i < 128; i++)
  {
    long v = abs(sample[i]);

    if (v > peak)
      peak = v;
  }

  Serial.print("bytes=");
  Serial.print(bytesRead);

  Serial.print(" peak=");
  Serial.println(peak);

  delay(100);
}
