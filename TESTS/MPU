#define LGFX_USE_V1

#include <Arduino.h>
#include <LovyanGFX.hpp>
#include <SPI.h>
#include <SD.h>

// ============================================================
// DISPLAY CONFIGURATION
// Board: ESP32-3248S035C
// Display: ST7796
// Landscape resolution: 480 x 320
// ============================================================

class LGFX : public lgfx::LGFX_Device
{
  lgfx::Panel_ST7796 panel;
  lgfx::Bus_SPI bus;
  lgfx::Light_PWM backlight;

public:
  LGFX()
  {
    // --------------------------------------------------------
    // Display SPI bus
    // --------------------------------------------------------

    {
      auto cfg = bus.config();

      cfg.spi_host = HSPI_HOST;
      cfg.spi_mode = 0;

      cfg.freq_write = 80000000;
      cfg.freq_read = 40000000;

      cfg.spi_3wire = true;
      cfg.use_lock = true;
      cfg.dma_channel = SPI_DMA_CH_AUTO;

      cfg.pin_sclk = 14;
      cfg.pin_mosi = 13;
      cfg.pin_miso = 12;
      cfg.pin_dc = 2;

      bus.config(cfg);
      panel.setBus(&bus);
    }

    // --------------------------------------------------------
    // ST7796 panel
    // --------------------------------------------------------

    {
      auto cfg = panel.config();

      cfg.pin_cs = 15;
      cfg.pin_rst = -1;
      cfg.pin_busy = -1;

      cfg.panel_width = 320;
      cfg.panel_height = 480;

      cfg.offset_x = 0;
      cfg.offset_y = 0;
      cfg.offset_rotation = 0;

      cfg.dummy_read_pixel = 8;
      cfg.dummy_read_bits = 1;

      cfg.readable = true;
      cfg.invert = false;
      cfg.rgb_order = false;
      cfg.dlen_16bit = false;
      cfg.bus_shared = true;

      panel.config(cfg);
    }

    // --------------------------------------------------------
    // Backlight
    // --------------------------------------------------------

    {
      auto cfg = backlight.config();

      cfg.pin_bl = 27;
      cfg.invert = false;
      cfg.freq = 1200;
      cfg.pwm_channel = 7;

      backlight.config(cfg);
      panel.setLight(&backlight);
    }

    setPanel(&panel);
  }
};

// ============================================================
// HARDWARE OBJECTS
// ============================================================

LGFX display;
SPIClass SDSPI(VSPI);

// ============================================================
// SD CARD CONFIGURATION
// ============================================================

static const int SD_CS = 5;
static const int SD_SCLK = 18;
static const int SD_MISO = 19;
static const int SD_MOSI = 23;

// ============================================================
// ASSET PATHS
// ============================================================

static const char* BACKGROUND_PATH =
  "/assets/backgrounds/default.png";

static const char* EYES_NEUTRAL_PATH =
  "/assets/eyes/neutral.png";

static const char* EYES_BLINK_PATH =
  "/assets/eyes/blink.png";

static const char* MOUTH_PATH =
  "/assets/mouth/expressionless.png";

// ============================================================
// FACE POSITIONING
//
// Adjust these values later after seeing the real result.
//
// Eyes and mouth are intentionally close together to produce
// the compact BMO ._. face instead of a vertically stretched
// face.
// ============================================================

static const int EYES_X = 0;
static const int EYES_Y = 20;

static const int MOUTH_X = 0;
static const int MOUTH_Y = 105;

// ============================================================
// BLINK SETTINGS
// ============================================================

static const unsigned long BLINK_DURATION_MS = 130;

static const unsigned long BLINK_MIN_INTERVAL_MS = 3000;
static const unsigned long BLINK_MAX_INTERVAL_MS = 7500;

// ============================================================
// ANIMATION STATE
// ============================================================

bool isBlinking = false;
bool faceNeedsRedraw = false;
bool setupComplete = false;

unsigned long blinkStartedAt = 0;
unsigned long nextBlinkAt = 0;

// ============================================================
// ERROR SCREEN
// ============================================================

void showError(
  const char* title,
  const char* message
)
{
  display.fillScreen(
    display.color565(20, 20, 20)
  );

  display.setTextSize(2);

  display.setTextColor(
    display.color565(255, 80, 80)
  );

  display.setCursor(20, 30);
  display.println(title);

  display.setTextColor(
    display.color565(255, 255, 255)
  );

  display.setCursor(20, 75);
  display.println(message);

  display.setCursor(20, 120);
  display.println("Check Serial Monitor.");
}

// ============================================================
// FILE CHECK
// ============================================================

bool fileExists(const char* path)
{
  File file = SD.open(path, FILE_READ);

  if (!file)
  {
    Serial.print("Missing file: ");
    Serial.println(path);

    return false;
  }

  Serial.print("Found: ");
  Serial.print(path);
  Serial.print(" | ");
  Serial.print(file.size());
  Serial.println(" bytes");

  file.close();

  return true;
}

// ============================================================
// LOAD AND DRAW PNG
//
// This is the same memory-buffer method that successfully
// displayed your background PNG.
//
// The PNG is:
// 1. Opened from SD
// 2. Loaded into RAM
// 3. Decoded by LovyanGFX
// 4. Removed from RAM afterwards
// ============================================================

bool loadAndDrawPng(
  const char* path,
  int32_t x,
  int32_t y
)
{
  File pngFile = SD.open(path, FILE_READ);

  if (!pngFile)
  {
    Serial.print("PNG OPEN FAILED: ");
    Serial.println(path);

    return false;
  }

  size_t pngSize = pngFile.size();

  if (pngSize == 0)
  {
    Serial.print("PNG FILE EMPTY: ");
    Serial.println(path);

    pngFile.close();
    return false;
  }

  uint8_t* pngBuffer =
    static_cast<uint8_t*>(malloc(pngSize));

  if (pngBuffer == nullptr)
  {
    Serial.print("PNG MEMORY FAILED: ");
    Serial.println(path);

    pngFile.close();
    return false;
  }

  size_t bytesRead = pngFile.read(
    pngBuffer,
    pngSize
  );

  pngFile.close();

  if (bytesRead != pngSize)
  {
    Serial.print("PNG READ FAILED: ");
    Serial.println(path);

    free(pngBuffer);
    return false;
  }

  bool drawResult = display.drawPng(
    pngBuffer,
    pngSize,
    x,
    y
  );

  free(pngBuffer);

  if (!drawResult)
  {
    Serial.print("PNG DECODE FAILED: ");
    Serial.println(path);

    return false;
  }

  return true;
}

// ============================================================
// DRAW COMPLETE FACE
//
// The background is redrawn before every eye change.
//
// This is necessary because the transparent PNG from the old
// eye position would otherwise remain visible underneath the
// new eye image.
// ============================================================

bool drawFace()
{
  bool success = true;

  display.startWrite();

  // Layer 0: Background
  success &= loadAndDrawPng(
    BACKGROUND_PATH,
    0,
    0
  );

  // Layer 1: Mouth
  success &= loadAndDrawPng(
    MOUTH_PATH,
    MOUTH_X,
    MOUTH_Y
  );

  // Layer 2: Eyes
  if (isBlinking)
  {
    success &= loadAndDrawPng(
      EYES_BLINK_PATH,
      EYES_X,
      EYES_Y
    );
  }
  else
  {
    success &= loadAndDrawPng(
      EYES_NEUTRAL_PATH,
      EYES_X,
      EYES_Y
    );
  }

  display.endWrite();

  faceNeedsRedraw = false;

  return success;
}

// ============================================================
// BLINK SYSTEM
// ============================================================

void scheduleNextBlink()
{
  nextBlinkAt =
    millis() +
    random(
      BLINK_MIN_INTERVAL_MS,
      BLINK_MAX_INTERVAL_MS + 1
    );

  Serial.print("Next blink in ");
  Serial.print(nextBlinkAt - millis());
  Serial.println(" ms");
}

void startBlink()
{
  isBlinking = true;
  blinkStartedAt = millis();
  faceNeedsRedraw = true;

  Serial.println("Blink closed");
}

void finishBlink()
{
  isBlinking = false;
  faceNeedsRedraw = true;

  Serial.println("Blink open");

  scheduleNextBlink();
}

void updateBlink()
{
  unsigned long now = millis();

  if (!isBlinking)
  {
    if (now >= nextBlinkAt)
    {
      startBlink();
    }

    return;
  }

  if (now - blinkStartedAt >= BLINK_DURATION_MS)
  {
    finishBlink();
  }
}

// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);
  delay(2000);

  Serial.println();
  Serial.println("=== BMO BLINK TEST ===");

  // ----------------------------------------------------------
  // Initialize display
  // ----------------------------------------------------------

  Serial.println("Initializing display...");

  display.init();
  display.setRotation(1);
  display.setBrightness(180);
  display.setColorDepth(16);
  display.setSwapBytes(true);

  display.fillScreen(
    display.color565(0, 0, 0)
  );

  Serial.print("Display size: ");
  Serial.print(display.width());
  Serial.print(" x ");
  Serial.println(display.height());

  // ----------------------------------------------------------
  // Initialize SD card
  // ----------------------------------------------------------

  Serial.println("Initializing SD card...");

  pinMode(SD_CS, OUTPUT);
  digitalWrite(SD_CS, HIGH);

  SDSPI.begin(
    SD_SCLK,
    SD_MISO,
    SD_MOSI,
    SD_CS
  );

  SDSPI.setFrequency(1000000);

  if (!SD.begin(SD_CS, SDSPI))
  {
    Serial.println("SD INITIALIZATION FAILED");

    showError(
      "SD ERROR",
      "Could not initialize SD card."
    );

    return;
  }

  Serial.println("SD INITIALIZATION SUCCESS");

  // ----------------------------------------------------------
  // Check all required files
  // ----------------------------------------------------------

  bool allFilesFound = true;

  allFilesFound &= fileExists(
    BACKGROUND_PATH
  );

  allFilesFound &= fileExists(
    EYES_NEUTRAL_PATH
  );

  allFilesFound &= fileExists(
    EYES_BLINK_PATH
  );

  allFilesFound &= fileExists(
    MOUTH_PATH
  );

  if (!allFilesFound)
  {
    showError(
      "ASSET ERROR",
      "One or more PNG files are missing."
    );

    return;
  }

  Serial.println("All required assets found.");

  // ----------------------------------------------------------
  // Initialize animation timing
  // ----------------------------------------------------------

  randomSeed(esp_random());

  scheduleNextBlink();

  // ----------------------------------------------------------
  // Draw initial BMO face
  // ----------------------------------------------------------

  Serial.println("Drawing initial face...");

  if (!drawFace())
  {
    showError(
      "RENDER ERROR",
      "Could not draw BMO face."
    );

    return;
  }

  setupComplete = true;

  Serial.println("BMO is alive.");
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop()
{
  if (!setupComplete)
  {
    delay(100);
    return;
  }

  updateBlink();

  if (faceNeedsRedraw)
  {
    if (!drawFace())
    {
      setupComplete = false;

      showError(
        "RENDER ERROR",
        "Face redraw failed."
      );

      return;
    }
  }

  delay(10);
}
