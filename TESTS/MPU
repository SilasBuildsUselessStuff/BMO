#include <Wire.h>

void setup()
{
  Serial.begin(115200);
  delay(2000);

  Serial.println("I2C SCAN");

  Wire.begin(21, 22);

  for (uint8_t address = 1; address < 127; address++)
  {
    Wire.beginTransmission(address);
    uint8_t error = Wire.endTransmission();

    if (error == 0)
    {
      Serial.print("FOUND: 0x");

      if (address < 16)
        Serial.print("0");

      Serial.println(address, HEX);
    }
  }

  Serial.println("SCAN DONE");
}

void loop()
{
}
