#define LGFX_USE_V1

#include <Arduino.h>
#include <LovyanGFX.hpp>
#include <SPI.h>
#include <SD.h>

// ============================================================
// DISPLAY CONFIGURATION
// Board: ESP32-3248S035C
// Display: ST7796
// Landscape resolution: 480 x 320
// ============================================================

class LGFX : public lgfx::LGFX_Device
{
  lgfx::Panel_ST7796 panel;
  lgfx::Bus_SPI bus;
  lgfx::Light_PWM backlight;

public:
  LGFX()
  {
    // --------------------------------------------------------
    // Display SPI bus
    // --------------------------------------------------------

    {
      auto cfg = bus.config();

      cfg.spi_host = HSPI_HOST;
      cfg.spi_mode = 0;

      cfg.freq_write = 80000000;
      cfg.freq_read = 40000000;

      cfg.spi_3wire = true;
      cfg.use_lock = true;
      cfg.dma_channel = SPI_DMA_CH_AUTO;

      cfg.pin_sclk = 14;
      cfg.pin_mosi = 13;
      cfg.pin_miso = 12;
      cfg.pin_dc = 2;

      bus.config(cfg);
      panel.setBus(&bus);
    }

    // --------------------------------------------------------
    // ST7796 panel
    // --------------------------------------------------------

    {
      auto cfg = panel.config();

      cfg.pin_cs = 15;
      cfg.pin_rst = -1;
      cfg.pin_busy = -1;

      cfg.panel_width = 320;
      cfg.panel_height = 480;

      cfg.offset_x = 0;
      cfg.offset_y = 0;
      cfg.offset_rotation = 0;

      cfg.dummy_read_pixel = 8;
      cfg.dummy_read_bits = 1;

      cfg.readable = true;
      cfg.invert = false;
      cfg.rgb_order = false;
      cfg.dlen_16bit = false;
      cfg.bus_shared = true;

      panel.config(cfg);
    }

    // --------------------------------------------------------
    // Backlight
    // --------------------------------------------------------

    {
      auto cfg = backlight.config();

      cfg.pin_bl = 27;
      cfg.invert = false;
      cfg.freq = 1200;
      cfg.pwm_channel = 7;

      backlight.config(cfg);
      panel.setLight(&backlight);
    }

    setPanel(&panel);
  }
};

// ============================================================
// HARDWARE OBJECTS
// ============================================================

LGFX display;
LGFX_Sprite frame(&display);

SPIClass SDSPI(VSPI);

// ============================================================
// SD CARD CONFIGURATION
// ============================================================

static constexpr int SD_CS = 5;
static constexpr int SD_SCLK = 18;
static constexpr int SD_MISO = 19;
static constexpr int SD_MOSI = 23;

// ============================================================
// DISPLAY SIZE
// ============================================================

static constexpr int SCREEN_WIDTH = 480;
static constexpr int SCREEN_HEIGHT = 320;

// ============================================================
// ASSET PATHS
// ============================================================

static const char* BACKGROUND_PATH =
  "/assets/backgrounds/default.png";

static const char* EYES_NEUTRAL_PATH =
  "/assets/eyes/neutral.png";

static const char* EYES_BLINK_PATH =
  "/assets/eyes/blink.png";

static const char* MOUTH_PATH =
  "/assets/mouth/expressionless.png";

// ============================================================
// FACE POSITIONING
//
// Adjust only these values if the visual placement is wrong.
// ============================================================

static constexpr int EYES_BASE_X = 0;
static constexpr int EYES_BASE_Y = 20;

static constexpr int MOUTH_BASE_X = 0;
static constexpr int MOUTH_BASE_Y = 100;

// ============================================================
// ANIMATION SETTINGS
// ============================================================

static constexpr unsigned long BLINK_DURATION_MS = 120;

static constexpr unsigned long BLINK_MIN_INTERVAL_MS = 3000;
static constexpr unsigned long BLINK_MAX_INTERVAL_MS = 7500;

static constexpr unsigned long EYE_TARGET_MIN_INTERVAL_MS = 1500;
static constexpr unsigned long EYE_TARGET_MAX_INTERVAL_MS = 4000;

static constexpr unsigned long EYE_STEP_INTERVAL_MS = 80;

static constexpr int MAX_EYE_OFFSET_X = 2;
static constexpr int MAX_EYE_OFFSET_Y = 1;

// ============================================================
// PNG MEMORY OBJECT
// ============================================================

struct PngAsset
{
  const char* path;
  uint8_t* data;
  size_t size;
  bool loaded;
};

// ============================================================
// PNG ASSETS
//
// All four files are loaded once during setup.
// This prevents repeated allocation and SD reads while blinking.
// ============================================================

PngAsset backgroundAsset =
{
  BACKGROUND_PATH,
  nullptr,
  0,
  false
};

PngAsset neutralEyesAsset =
{
  EYES_NEUTRAL_PATH,
  nullptr,
  0,
  false
};

PngAsset blinkEyesAsset =
{
  EYES_BLINK_PATH,
  nullptr,
  0,
  false
};

PngAsset mouthAsset =
{
  MOUTH_PATH,
  nullptr,
  0,
  false
};

// ============================================================
// ANIMATION STATE
// ============================================================

bool setupComplete = false;
bool isBlinking = false;
bool faceNeedsRedraw = true;

int eyeOffsetX = 0;
int eyeOffsetY = 0;

int targetEyeOffsetX = 0;
int targetEyeOffsetY = 0;

unsigned long blinkStartedAt = 0;
unsigned long nextBlinkAt = 0;

unsigned long nextEyeTargetAt = 0;
unsigned long lastEyeStepAt = 0;

// ============================================================
// ERROR SCREEN
// ============================================================

void showError(
  const char* title,
  const char* message
)
{
  display.fillScreen(
    display.color565(20, 20, 20)
  );

  display.setTextSize(2);

  display.setTextColor(
    display.color565(255, 80, 80)
  );

  display.setCursor(20, 30);
  display.println(title);

  display.setTextColor(
    display.color565(255, 255, 255)
  );

  display.setCursor(20, 75);
  display.println(message);

  display.setCursor(20, 120);
  display.println("Check Serial Monitor.");
}

// ============================================================
// LOAD PNG INTO MEMORY
// ============================================================

bool loadPngAsset(PngAsset& asset)
{
  Serial.print("Loading: ");
  Serial.println(asset.path);

  File file = SD.open(
    asset.path,
    FILE_READ
  );

  if (!file)
  {
    Serial.print("FILE NOT FOUND: ");
    Serial.println(asset.path);

    return false;
  }

  asset.size = file.size();

  if (asset.size == 0)
  {
    Serial.print("FILE EMPTY: ");
    Serial.println(asset.path);

    file.close();
    return false;
  }

  asset.data =
    static_cast<uint8_t*>(
      malloc(asset.size)
    );

  if (asset.data == nullptr)
  {
    Serial.print("MEMORY ALLOCATION FAILED: ");
    Serial.println(asset.path);

    Serial.print("Required bytes: ");
    Serial.println(asset.size);

    Serial.print("Free heap: ");
    Serial.println(ESP.getFreeHeap());

    file.close();
    return false;
  }

  size_t bytesRead = file.read(
    asset.data,
    asset.size
  );

  file.close();

  if (bytesRead != asset.size)
  {
    Serial.print("INCOMPLETE READ: ");
    Serial.println(asset.path);

    free(asset.data);
    asset.data = nullptr;
    asset.size = 0;

    return false;
  }

  asset.loaded = true;

  Serial.print("Loaded ");
  Serial.print(asset.size);
  Serial.println(" bytes");

  return true;
}

// ============================================================
// DRAW PNG INTO FRAME SPRITE
//
// The PNG is decoded into the off-screen frame, not directly
// onto the physical display.
//
// Because the frame already contains the background, transparent
// PNG pixels can preserve the background underneath.
// ============================================================

bool drawAssetToFrame(
  const PngAsset& asset,
  int32_t x,
  int32_t y
)
{
  if (
    !asset.loaded ||
    asset.data == nullptr ||
    asset.size == 0
  )
  {
    Serial.print("ASSET NOT LOADED: ");
    Serial.println(asset.path);

    return false;
  }

  bool result = frame.drawPng(
    asset.data,
    asset.size,
    x,
    y
  );

  if (!result)
  {
    Serial.print("PNG DECODE FAILED: ");
    Serial.println(asset.path);
  }

  return result;
}

// ============================================================
// DRAW COMPLETE FACE
// ============================================================

bool drawFace()
{
  bool success = true;

  // Clear the off-screen frame before rebuilding every layer.
  frame.fillScreen(
    display.color565(0, 0, 0)
  );

  // Layer 0: full-screen background
  success &= drawAssetToFrame(
    backgroundAsset,
    0,
    0
  );

  // Layer 1: mouth
  success &= drawAssetToFrame(
    mouthAsset,
    MOUTH_BASE_X,
    MOUTH_BASE_Y
  );

  // Layer 2: eyes
  if (isBlinking)
  {
    success &= drawAssetToFrame(
      blinkEyesAsset,
      EYES_BASE_X + eyeOffsetX,
      EYES_BASE_Y + eyeOffsetY
    );
  }
  else
  {
    success &= drawAssetToFrame(
      neutralEyesAsset,
      EYES_BASE_X + eyeOffsetX,
      EYES_BASE_Y + eyeOffsetY
    );
  }

  if (!success)
  {
    return false;
  }

  // Transfer the completed frame to the physical display.
  frame.pushSprite(0, 0);

  faceNeedsRedraw = false;

  return true;
}

// ============================================================
// BLINK SYSTEM
// ============================================================

void scheduleNextBlink()
{
  nextBlinkAt =
    millis() +
    random(
      BLINK_MIN_INTERVAL_MS,
      BLINK_MAX_INTERVAL_MS + 1
    );
}

void updateBlink()
{
  unsigned long now = millis();

  if (!isBlinking)
  {
    if (now >= nextBlinkAt)
    {
      isBlinking = true;
      blinkStartedAt = now;
      faceNeedsRedraw = true;

      Serial.println("Blink closed");
    }

    return;
  }

  if (
    now - blinkStartedAt >=
    BLINK_DURATION_MS
  )
  {
    isBlinking = false;
    faceNeedsRedraw = true;

    scheduleNextBlink();

    Serial.println("Blink open");
  }
}

// ============================================================
// EYE MOVEMENT SYSTEM
// ============================================================

void chooseNewEyeTarget()
{
  targetEyeOffsetX =
    random(
      -MAX_EYE_OFFSET_X,
      MAX_EYE_OFFSET_X + 1
    );

  targetEyeOffsetY =
    random(
      -MAX_EYE_OFFSET_Y,
      MAX_EYE_OFFSET_Y + 1
    );

  nextEyeTargetAt =
    millis() +
    random(
      EYE_TARGET_MIN_INTERVAL_MS,
      EYE_TARGET_MAX_INTERVAL_MS + 1
    );
}

void updateEyeMovement()
{
  unsigned long now = millis();

  if (now >= nextEyeTargetAt)
  {
    chooseNewEyeTarget();
  }

  if (
    now - lastEyeStepAt <
    EYE_STEP_INTERVAL_MS
  )
  {
    return;
  }

  lastEyeStepAt = now;

  bool moved = false;

  if (eyeOffsetX < targetEyeOffsetX)
  {
    eyeOffsetX++;
    moved = true;
  }
  else if (eyeOffsetX > targetEyeOffsetX)
  {
    eyeOffsetX--;
    moved = true;
  }

  if (eyeOffsetY < targetEyeOffsetY)
  {
    eyeOffsetY++;
    moved = true;
  }
  else if (eyeOffsetY > targetEyeOffsetY)
  {
    eyeOffsetY--;
    moved = true;
  }

  if (moved)
  {
    faceNeedsRedraw = true;
  }
}

// ============================================================
// SETUP
// ============================================================

void setup()
{
  Serial.begin(115200);
  delay(2000);

  Serial.println();
  Serial.println("=== BMO TRANSPARENT BLINK TEST ===");

  // ----------------------------------------------------------
  // Initialize physical display
  // ----------------------------------------------------------

  display.init();
  display.setRotation(1);
  display.setBrightness(180);
  display.setColorDepth(16);
  display.setSwapBytes(true);

  display.fillScreen(
    display.color565(0, 0, 0)
  );

  Serial.print("Display size: ");
  Serial.print(display.width());
  Serial.print(" x ");
  Serial.println(display.height());

  // ----------------------------------------------------------
  // Initialize SD card
  // ----------------------------------------------------------

  pinMode(SD_CS, OUTPUT);
  digitalWrite(SD_CS, HIGH);

  SDSPI.begin(
    SD_SCLK,
    SD_MISO,
    SD_MOSI,
    SD_CS
  );

  SDSPI.setFrequency(1000000);

  if (!SD.begin(SD_CS, SDSPI))
  {
    Serial.println("SD INITIALIZATION FAILED");

    showError(
      "SD ERROR",
      "Could not initialize SD card."
    );

    return;
  }

  Serial.println("SD initialized.");

  // ----------------------------------------------------------
  // Create off-screen frame sprite
  //
  // 8-bit color is used because:
  // 480 x 320 x 1 byte = about 154 KB
  //
  // A 16-bit frame would require about 307 KB and may fail
  // on an ESP32-WROOM without PSRAM.
  // ----------------------------------------------------------

  frame.setColorDepth(8);

  void* frameBuffer =
    frame.createSprite(
      SCREEN_WIDTH,
      SCREEN_HEIGHT
    );

  if (frameBuffer == nullptr)
  {
    Serial.println("FRAME SPRITE CREATION FAILED");

    Serial.print("Free heap: ");
    Serial.println(ESP.getFreeHeap());

    showError(
      "MEMORY ERROR",
      "Could not create face frame."
    );

    return;
  }

  frame.setSwapBytes(true);

  Serial.println("Frame sprite created.");

  Serial.print("Free heap after frame: ");
  Serial.println(ESP.getFreeHeap());

  // ----------------------------------------------------------
  // Load all required PNG files once
  // ----------------------------------------------------------

  bool loaded = true;

  loaded &= loadPngAsset(
    backgroundAsset
  );

  loaded &= loadPngAsset(
    neutralEyesAsset
  );

  loaded &= loadPngAsset(
    blinkEyesAsset
  );

  loaded &= loadPngAsset(
    mouthAsset
  );

  if (!loaded)
  {
    showError(
      "ASSET ERROR",
      "Could not load one or more PNGs."
    );

    return;
  }

  Serial.println("All PNG assets loaded.");

  // ----------------------------------------------------------
  // Initialize animation
  // ----------------------------------------------------------

  randomSeed(esp_random());

  scheduleNextBlink();

  nextEyeTargetAt =
    millis() +
    random(1000, 2501);

  // ----------------------------------------------------------
  // Draw initial face
  // ----------------------------------------------------------

  if (!drawFace())
  {
    showError(
      "RENDER ERROR",
      "Could not compose BMO face."
    );

    return;
  }

  setupComplete = true;

  Serial.println("BMO is alive.");
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop()
{
  if (!setupComplete)
  {
    delay(100);
    return;
  }

  updateBlink();
  updateEyeMovement();

  if (faceNeedsRedraw)
  {
    if (!drawFace())
    {
      setupComplete = false;

      showError(
        "RENDER ERROR",
        "Could not redraw BMO face."
      );

      return;
    }
  }

  delay(10);
}
