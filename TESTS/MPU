void setup()
{
  Serial.begin(115200);
  delay(2000);

  display.init();
  display.setRotation(1);

  display.fillScreen(TFT_BLACK);

  pinMode(5, OUTPUT);
  digitalWrite(5, HIGH);

  SDSPI.begin(18, 19, 23);
  SDSPI.setFrequency(1000000);

  if (!SD.begin(5, SDSPI))
  {
    Serial.println("SD FAIL");
    return;
  }

  Serial.println("SD OK");

  File test = SD.open("/assets/background/default.png");

  if (!test)
  {
    Serial.println("PNG NOT FOUND");
    return;
  }

  Serial.print("PNG SIZE=");
  Serial.println(test.size());

  test.close();

  display.setTextColor(TFT_WHITE);
  display.setTextSize(2);
  display.setCursor(20, 20);

  display.println("SD OK");
  display.println("PNG FOUND");
}
