#define LGFX_USE_V1
#include <LovyanGFX.hpp>

// ============================================================
// Display Configuration
// ============================================================

class LGFX : public lgfx::LGFX_Device
{
  lgfx::Panel_ST7796 _panel_instance;
  lgfx::Bus_SPI _bus_instance;
  lgfx::Light_PWM _light_instance;

public:
  LGFX(void)
  {
    {
      auto cfg = _bus_instance.config();

      cfg.spi_host = HSPI_HOST;
      cfg.spi_mode = 0;
      cfg.freq_write = 80000000;
      cfg.freq_read  = 40000000;

      cfg.spi_3wire = true;
      cfg.use_lock = true;
      cfg.dma_channel = SPI_DMA_CH_AUTO;

      cfg.pin_sclk = 14;
      cfg.pin_mosi = 13;
      cfg.pin_miso = 12;
      cfg.pin_dc   = 2;

      _bus_instance.config(cfg);
      _panel_instance.setBus(&_bus_instance);
    }

    {
      auto cfg = _panel_instance.config();

      cfg.pin_cs = 15;
      cfg.pin_rst = -1;

      cfg.panel_width  = 320;
      cfg.panel_height = 480;

      _panel_instance.config(cfg);
    }

    {
      auto cfg = _light_instance.config();

      cfg.pin_bl = 27;
      cfg.invert = false;
      cfg.freq = 1200;
      cfg.pwm_channel = 7;

      _light_instance.config(cfg);
      _panel_instance.setLight(&_light_instance);
    }

    setPanel(&_panel_instance);
  }
};

LGFX display;

// ============================================================

void setup()
{
  Serial.begin(115200);

  delay(2000);

  display.init();
  display.setRotation(1);
  display.setBrightness(200);

  display.fillScreen(display.color565(154,218,190));

  int w = display.width();
  int h = display.height();

  Serial.print("Display Size: ");
  Serial.print(w);
  Serial.print(" x ");
  Serial.println(h);

  // Eyes Layer

  display.drawRect(
      0,
      20,
      w,
      160,
      TFT_RED);

  display.setCursor(10, 30);
  display.setTextColor(TFT_RED);
  display.setTextSize(2);
  display.print("EYES LAYER");

  // Example eye positions

  display.fillCircle(160, 100, 15, TFT_BLACK);
  display.fillCircle(320, 100, 15, TFT_BLACK);

  // Mouth Layer

  display.drawRect(
      0,
      180,
      w,
      120,
      TFT_BLUE);

  display.setCursor(10, 190);
  display.setTextColor(TFT_BLUE);
  display.print("MOUTH LAYER");

  display.drawLine(
      200,
      250,
      280,
      250,
      TFT_BLACK);

  // UI Layer

  display.drawRect(
      0,
      300,
      w,
      h - 300,
      TFT_GREEN);

  display.setCursor(10, 310);
  display.setTextColor(TFT_GREEN);
  display.print("UI LAYER");
}

void loop()
{
}
