File assets = SD.open("/assets");

if (!assets)
{
  Serial.println("ASSETS FAIL");
  return;
}

Serial.println("ASSETS OK");

File file = assets.openNextFile();

while (file)
{
  if (file.isDirectory())
  {
    Serial.print("[DIR ] ");
    Serial.println(file.name());
  }
  else
  {
    Serial.print("[FILE] ");
    Serial.println(file.name());
  }

  file = assets.openNextFile();
}

Serial.println("DONE");
