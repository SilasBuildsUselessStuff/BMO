#include <SPI.h>
#include <SD.h>

#define SD_CS 4

void setup()
{
  Serial.begin(115200);

  delay(1000);

  Serial.println("=== SD TEST ===");

  if (!SD.begin(SD_CS))
  {
    Serial.println("SD FAILED");
    return;
  }

  Serial.println("SD OK");

  File root = SD.open("/");

  while (true)
  {
    File file = root.openNextFile();

    if (!file)
    {
      Serial.println("DONE");
      break;
    }

    Serial.print("FILE: ");
    Serial.println(file.name());

    file.close();
  }
}

void loop()
{
}
