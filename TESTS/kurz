#include <SPI.h>
#include <SD.h>

SPIClass SDSPI(VSPI);

void setup()
{
  Serial.begin(115200);

  delay(2000);

  Serial.println("A");

  SDSPI.begin(18, 19, 23);

  Serial.println("B");

  bool ok = SD.begin(5, SDSPI);

  Serial.println("C");

  if (ok)
  {
    Serial.println("SD OK");
  }
  else
  {
    Serial.println("SD FAIL");
  }
}

void loop()
{
}
